{
    "name": "nonini/db-migration",
    "description": "Simple DB migration helper",
    "type": "library",
    "require": {
        "php": ">=7.4"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "nonini\\DbMigration\\": "src"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.3",
        "squizlabs/php_codesniffer": "^3.7",
        "symplify/easy-coding-standard": "^12.0.8"
    }
}
